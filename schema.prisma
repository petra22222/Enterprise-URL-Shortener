// FILE: prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum PlanType {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum AbuseReportStatus {
  OPEN
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  isSuspended   Boolean   @default(false)
  planType      PlanType  @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  links                Link[]
  subscription         Subscription?
  customDomains        CustomDomain[]
  abuseReportsFiled    AbuseReport[]     @relation("ReportedBy")
  auditLogs            AuditLog[]
  workspaceMemberships WorkspaceMember[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  members WorkspaceMember[]
  links   Link[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model CustomDomain {
  id                String       @id @default(cuid())
  ownerId           String
  owner             User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hostname          String       @unique
  status            DomainStatus @default(PENDING)
  verificationToken String       @default(cuid())
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())

  links Link[]

  @@index([ownerId])
}

model Link {
  id             String        @id @default(cuid())
  ownerId        String?
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  originalUrl    String        @db.Text
  domain         String
  shortCode      String
  customDomainId String?
  customDomain   CustomDomain? @relation(fields: [customDomainId], references: [id], onDelete: SetNull)
  title          String?
  passwordHash   String?
  expiresAt      DateTime?
  isActive       Boolean       @default(true)
  clickCount     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clickEvents  ClickEvent[]
  abuseReports AbuseReport[]

  @@unique([domain, shortCode])
  @@index([shortCode])
  @@index([ownerId])
  @@index([createdAt])
}

model ClickEvent {
  id          String   @id @default(cuid())
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  occurredAt  DateTime @default(now())
  referrer    String?
  country     String?
  deviceType  String?
  browser     String?
  os          String?
  visitorHash String?
  isBot       Boolean  @default(false)

  @@index([linkId, occurredAt])
  @@index([occurredAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType              PlanType           @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model AbuseReport {
  id         String            @id @default(cuid())
  linkId     String
  link       Link              @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?             @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String
  details    String?           @db.Text
  status     AbuseReportStatus @default(OPEN)
  createdAt  DateTime          @default(now())
  reviewedAt DateTime?

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}